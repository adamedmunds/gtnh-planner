# Copy to .env (git-ignored) so `npm run textures` and `npm run recipes` find your game files without flags.

# Your GTNH instance's .minecraft folder (textures come from its mods and the Minecraft jar)
GTNH_INSTANCE="C:/Users/<you>/AppData/Roaming/PrismLauncher/instances/<GTNH instance>/.minecraft"

# The file written by /gtnhplanner dump in-game
GTNH_DUMP="C:/Users/<you>/AppData/Roaming/PrismLauncher/instances/<GTNH instance>/.minecraft/gtnh-planner/recipes.json.gz"
